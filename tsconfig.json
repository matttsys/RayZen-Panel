{
    "include": [
        "src",
        "tests",
        "vitest.config.ts"
    ],
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "types": [
            "@cloudflare/workers-types",
            "node"
        ],
        "moduleResolution": "bundler",
        "strict": true,
        "noUnusedLocals": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": false,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "paths": {
            "@cores/*": [
                "./src/cores/*"
            ],
            "@xray/*": [
                "./src/cores/xray/*"
            ],
            "@sing-box/*": [
                "./src/cores/sing-box/*"
            ],
            "@clash/*": [
                "./src/cores/clash/*"
            ],
            "@utils": [
                "./src/cores/utils"
            ],
            "@handlers/*": [
                "./src/handlers/*"
            ],
            "@settings": [
                "./src/settings/settings"
            ],
            "@settings-loader": [
                "./src/settings/load"
            ],
            "@validators": [
                "./src/settings/validators"
            ],
            "@common": [
                "./src/common/common"
            ],
            "@security": [
                "./src/common/security"
            ],
            "@runtime": [
                "./src/common/runtime"
            ],
            "@storage": [
                "./src/storage/storage"
            ],
            "@kv": [
                "./src/settings/kv"
            ],
            "@identity": [
                "./src/settings/identity"
            ],
            "@main": [
                "./src/settings/main"
            ],
            "@api/*": [
                "./src/api/*"
            ],
            "@protocols/*": [
                "./src/protocols/*"
            ],
            "@auth": [
                "./src/auth/auth"
            ],
            "@platform/*": [
                "./src/platform/*"
            ],
            "@features/*": [
                "./src/features/*"
            ],
            "#types/*": [
                "./src/types/*"
            ]
        }
    }
}
