  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "RayZen Design System",
    "version": "1.1.0",
    "principles": ["calm precision", "network clarity", "soft depth", "motion with purpose", "RTL-native"]
  },
  "spacing": {"0":0,"1":2,"2":4,"3":8,"4":12,"5":16,"6":20,"7":24,"8":32,"9":40,"10":48,"11":64,"12":80},
