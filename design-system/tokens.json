    "familyPersian": "Vazirmatn, 'Noto Sans Arabic UI', 'Noto Sans Arabic', Tahoma, sans-serif",
    "familyMono": "'SFMono-Regular', 'Cascadia Code', 'Roboto Mono', ui-monospace, monospace",
    "display": {"size":48,"line":52,"weight":720,"tracking":-1.5},
    "headline": {"size":32,"line":38,"weight":700,"tracking":-0.8},
    "title": {"size":22,"line":28,"weight":680,"tracking":-0.35},
    "body": {"size":15,"line":23,"weight":450,"tracking":0},
    "bodyStrong": {"size":15,"line":22,"weight":640,"tracking":0},
    "label": {"size":13,"line":18,"weight":650,"tracking":0.1},
    "caption": {"size":11,"line":16,"weight":620,"tracking":0.75}
  },
  "motion": {
    "instant": 80,
    "fast": 140,
    "standard": 220,
    "emphasis": 320,
    "hero": 480,
    "easeStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "easeEnter": "cubic-bezier(0.05, 0.7, 0.1, 1)",
    "easeExit": "cubic-bezier(0.3, 0, 0.8, 0.15)",
    "spring": "linear(0, .012, .052 2%, .18 4%, .72 10%, 1.03 16%, .985 21%, 1.002 30%, 1)"
  },
  "elevation": {
