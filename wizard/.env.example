# Public URL of this Vercel deployment, without a trailing slash.
WIZARD_PUBLIC_URL=https://rayzen.bond

# 32+ random bytes. Used only server-side to encrypt short-lived session cookies.
WIZARD_SESSION_SECRET=replace-with-a-long-random-secret

# Cloudflare self-managed OAuth client credentials.
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=

# Space-separated OAuth scope IDs configured for the Cloudflare OAuth client.
CLOUDFLARE_OAUTH_SCOPES=
